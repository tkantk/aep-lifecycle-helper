# All fields have sensible defaults - copy to .env and override only what you need.
# Or skip .env entirely and use the UI to configure.

PORT=3000
OPEN_BROWSER=1

# ─── Adobe endpoints ─────────────────────────────────────────
IMS_HOST=https://ims-na1.adobelogin.com
AEP_GATEWAY=https://platform.adobe.io
AEP_IDENTITY_REGION=va7

# ─── Throughput tuning ───────────────────────────────────────
# 5 is the safe default (lowered from 10 after a 2026-05-29 Adobe rate-limit
# incident). Raise only if the expansion summary logs show rateLimitHits=0 and
# timeoutRetries=0; lower it if Adobe answers slowly.
IDENTITY_CONCURRENCY=5
IDENTITY_BATCH_SIZE=1000
# Identity Graph lookup timeout (ms; default 120000, or REQUEST_TIMEOUT_MS if
# that is higher). A lookup that times out is retried automatically (up to 5
# times); smaller IDENTITY_BATCH_SIZE = faster answers.
IDENTITY_TIMEOUT_MS=120000
# Every other Adobe call (ms) — never retried after a timeout when it could
# have changed something (work-order submit).
REQUEST_TIMEOUT_MS=60000
WORK_ORDER_CONCURRENCY=2
MAX_IDS_PER_WORK_ORDER=100000
DAILY_IDENTIFIER_LIMIT=1000000

# ─── Expansion activity (logs + Expansion tab) ──────────────
# "still waiting on Adobe" after this long without a finished batch (ms), and a
# Resume progress line every RESUME_LOG_EVERY already-expanded IDs skipped.
EXPANSION_HEARTBEAT_MS=30000
RESUME_LOG_EVERY=100000

# ─── Optional override ───────────────────────────────────────
# 64-hex-char key for encrypting client secrets. If unset, a random key
# is auto-generated at data/.key on first run.
# ENCRYPTION_KEY=
